<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="0dp"
    android:paddingEnd="16dp"
    android:paddingBottom="32dp">

    <!-- Appearance -->
    <TextView
        style="@style/EdgeSectionTitle"
        android:layout_marginTop="8dp"
        android:text="Appearance" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/rowDynamic"
        style="@style/EdgeSeg.Top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout style="@style/EdgeListRow">

            <ImageView
                android:id="@+id/dynIcon"
                style="@style/EdgeIconBox"
                android:src="@drawable/ic_palette" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/EdgeHeadline"
                    android:text="Dynamic colour" />

                <TextView
                    android:id="@+id/dynSupport"
                    style="@style/EdgeSupporting" />
            </LinearLayout>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/dynSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="Dynamic colour" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        style="@style/EdgeSeg.Bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            style="@style/EdgeListRow"
            android:minHeight="56dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Palette in use"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="?attr/colorOnSurface" />

            <View
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="0dp"
                android:background="@drawable/bg_dot"
                android:backgroundTint="?attr/colorPrimary" />

            <View
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_dot"
                android:backgroundTint="?attr/colorSecondary" />

            <View
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_dot"
                android:backgroundTint="?attr/colorTertiary" />

            <View
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_dot"
                android:backgroundTint="?attr/colorPrimaryContainer" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Behaviour -->
    <TextView
        style="@style/EdgeSectionTitle"
        android:text="Behaviour" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/rowVibrate"
        style="@style/EdgeSeg.Top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout style="@style/EdgeListRow">

            <ImageView
                android:id="@+id/vibrateIcon"
                style="@style/EdgeIconBox"
                android:src="@drawable/ic_vibration" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="Vibrate on swipe"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="?attr/colorOnSurface" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/vibrateSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="Vibrate on swipe" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/rowIcon"
        style="@style/EdgeSeg.Bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout style="@style/EdgeListRow">

            <ImageView
                android:id="@+id/iconIcon"
                style="@style/EdgeIconBox"
                android:src="@drawable/ic_visibility" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/EdgeHeadline"
                    android:text="Hide app icon" />

                <TextView
                    style="@style/EdgeSupporting"
                    android:text="Service keeps working" />
            </LinearLayout>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/iconSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="Hide app icon" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Setup -->
    <TextView
        style="@style/EdgeSectionTitle"
        android:text="Setup" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/rowAccessibility"
        style="@style/EdgeSeg.Top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout style="@style/EdgeListRow">

            <ImageView
                style="@style/EdgeIconBox"
                android:src="@drawable/ic_accessibility" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/EdgeHeadline"
                    android:text="Accessibility" />

                <TextView
                    style="@style/EdgeSupporting"
                    android:text="Service on or off" />
            </LinearLayout>

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_open_in_new" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/rowRestricted"
        style="@style/EdgeSeg.Middle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout style="@style/EdgeListRow">

            <ImageView
                style="@style/EdgeIconBox"
                android:src="@drawable/ic_shield" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/EdgeHeadline"
                    android:text="Restricted settings" />

                <TextView
                    style="@style/EdgeSupporting"
                    android:text="Android 13+, App info menu" />
            </LinearLayout>

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_open_in_new" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/rowHelp"
        style="@style/EdgeSeg.Bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout style="@style/EdgeListRow">

            <ImageView
                style="@style/EdgeIconBox"
                android:src="@drawable/ic_help" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="How it works"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="?attr/colorOnSurface" />

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_chevron_right" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- About developer -->
    <TextView
        style="@style/EdgeSectionTitle"
        android:text="About developer" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/rowDev"
        style="@style/EdgeSeg.Top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout style="@style/EdgeListRow">

            <ImageView
                style="@style/EdgeIconBox"
                android:src="@drawable/ic_code" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/EdgeHeadline"
                    android:text="sudoflash01" />

                <TextView
                    style="@style/EdgeSupporting"
                    android:text="Developer of Edge Action" />
            </LinearLayout>

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_open_in_new" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/rowStar"
        style="@style/EdgeSeg.Bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout style="@style/EdgeListRow">

            <ImageView
                style="@style/EdgeIconBox"
                android:src="@drawable/ic_star" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/EdgeHeadline"
                    android:text="Star on GitHub" />

                <TextView
                    style="@style/EdgeSupporting"
                    android:text="Like the app? A star helps a lot" />
            </LinearLayout>

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_open_in_new" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/version"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/colorOnSurfaceVariant" />
</LinearLayout>
