<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="8dp"
    android:paddingEnd="16dp"
    android:paddingBottom="104dp">

    <!-- service status card: primary colour when on, error colour when off (colour animates) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/statusCard"
        style="@style/EdgeCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/statusIconWrap"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_dot">

                    <ImageView
                        android:id="@+id/statusIcon"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_check_circle" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/statusTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceTitleLarge" />

                    <TextView
                        android:id="@+id/statusBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textAppearance="?attr/textAppearanceBodyMedium" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/statusActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAccessibility"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Turn on"
                    android:textColor="?attr/colorOnError"
                    app:backgroundTint="?attr/colorError" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRestricted"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="Restricted"
                    android:textColor="?attr/colorOnErrorContainer"
                    app:backgroundTint="?attr/colorSurfaceContainerLowest" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- edge space: 2 small meters, label + "used / 200 dp" + bar with a dot at the end -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/edgeCard"
        style="@style/EdgeCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/EdgeSupporting"
                    android:text="Left edge"
                    android:textAppearance="?attr/textAppearanceLabelLarge" />

                <TextView
                    android:id="@+id/leftText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="?attr/colorOnSurface" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/leftBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:max="200"
                    app:indicatorColor="?attr/colorTertiary"
                    app:trackColor="?attr/colorSurfaceContainerHighest"
                    app:trackCornerRadius="4dp"
                    app:trackStopIndicatorSize="4dp"
                    app:trackThickness="8dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/EdgeSupporting"
                    android:text="Right edge"
                    android:textAppearance="?attr/textAppearanceLabelLarge" />

                <TextView
                    android:id="@+id/rightText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="?attr/colorOnSurface" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/rightBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:max="200"
                    app:indicatorColor="?attr/colorPrimary"
                    app:trackColor="?attr/colorSurfaceContainerHighest"
                    app:trackCornerRadius="4dp"
                    app:trackStopIndicatorSize="4dp"
                    app:trackThickness="8dp" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- one list item, same like settings rows. icon shows the state, switch is the only control -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/previewCard"
        style="@style/EdgeCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout style="@style/EdgeListRow">

            <ImageView
                android:id="@+id/previewIcon"
                style="@style/EdgeIconBox"
                android:src="@drawable/ic_visibility" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/EdgeHeadline"
                    android:text="Show strips on screen" />

                <TextView
                    android:id="@+id/previewSub"
                    style="@style/EdgeSupporting" />
            </LinearLayout>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/previewSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="Show or hide all strip previews" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/stripsTitle"
        style="@style/EdgeSectionTitle"
        android:text="Strips" />

    <LinearLayout
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/empty"
        style="@style/EdgeCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="32dp">

            <ImageView
                style="@style/EdgeIconBox"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginEnd="0dp"
                android:padding="16dp"
                android:src="@drawable/ic_swap_horiz" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="No strips yet"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                style="@style/EdgeSupporting"
                android:layout_width="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Add one and place it on an edge" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEmptyAdd"
                style="@style/Widget.Material3.Button.TonalButton.Icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Add strip"
                app:icon="@drawable/ic_add" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
