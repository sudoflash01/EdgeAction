<resources>
    <style name="Theme.EdgeAction" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/md_primary</item>
        <item name="colorOnPrimary">@color/md_on_primary</item>
        <item name="colorPrimaryContainer">@color/md_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/md_on_primary_container</item>
        <item name="colorSecondary">@color/md_secondary</item>
        <item name="colorOnSecondary">@color/md_on_secondary</item>
        <item name="colorSecondaryContainer">@color/md_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/md_on_secondary_container</item>
        <item name="colorTertiary">@color/md_tertiary</item>
        <item name="colorOnTertiary">@color/md_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/md_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/md_on_tertiary_container</item>
        <item name="colorError">@color/md_error</item>
        <item name="colorOnError">@color/md_on_error</item>
        <item name="colorErrorContainer">@color/md_error_container</item>
        <item name="colorOnErrorContainer">@color/md_on_error_container</item>
        <item name="android:colorBackground">@color/md_background</item>
        <item name="colorOnBackground">@color/md_on_background</item>
        <item name="colorSurface">@color/md_surface</item>
        <item name="colorOnSurface">@color/md_on_surface</item>
        <item name="colorSurfaceVariant">@color/md_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/md_on_surface_variant</item>
        <item name="colorOutline">@color/md_outline</item>
        <item name="colorOutlineVariant">@color/md_outline_variant</item>
        <item name="colorSurfaceInverse">@color/md_inverse_surface</item>
        <item name="colorOnSurfaceInverse">@color/md_inverse_on_surface</item>
        <item name="colorPrimaryInverse">@color/md_inverse_primary</item>
        <item name="colorSurfaceContainerLowest">@color/md_surface_container_lowest</item>
        <item name="colorSurfaceContainerLow">@color/md_surface_container_low</item>
        <item name="colorSurfaceContainer">@color/md_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/md_surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/md_surface_container_highest</item>
        <item name="android:statusBarColor">?attr/colorSurface</item>
        <item name="android:navigationBarColor">?attr/colorSurfaceContainer</item>
        <item name="materialSwitchStyle">@style/EdgeSwitch</item>
        <item name="bottomSheetDialogTheme">@style/EdgeBottomSheetDialog</item>
        <item name="android:windowAnimationStyle">@style/EdgeWindowAnim</item>
    </style>


    <!-- cards: no outline. card is little lighter than page (surfaceContainerHigh on surface), only that difference separates it, so it works in light, dark and dynamic colour -->
    <style name="EdgeCard" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">?attr/colorSurfaceContainerHigh</item>
        <item name="strokeWidth">0dp</item>
        <item name="cardElevation">0dp</item>
        <!-- without this, top / bottom rows (different corners) get ~8dp extra padding and their icons go more inside than middle rows -->
        <item name="cardPreventCornerOverlap">false</item>
        <item name="shapeAppearanceOverlay">@style/EdgeShape.Single</item>
    </style>

    <!-- grouped list: every row is a separate card with 2dp gap, outer corners big, corners between rows small -->
    <style name="EdgeSeg" parent="EdgeCard">
        <item name="android:layout_marginBottom">2dp</item>
    </style>
    <style name="EdgeSeg.Top"><item name="shapeAppearanceOverlay">@style/EdgeShape.Top</item></style>
    <style name="EdgeSeg.Middle"><item name="shapeAppearanceOverlay">@style/EdgeShape.Middle</item></style>
    <style name="EdgeSeg.Bottom"><item name="shapeAppearanceOverlay">@style/EdgeShape.Bottom</item></style>
    <style name="EdgeSeg.Single"><item name="shapeAppearanceOverlay">@style/EdgeShape.Single</item></style>

    <style name="EdgeShape.Single" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>
    <style name="EdgeShape.Top" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">28dp</item>
        <item name="cornerSizeTopRight">28dp</item>
        <item name="cornerSizeBottomLeft">6dp</item>
        <item name="cornerSizeBottomRight">6dp</item>
    </style>
    <style name="EdgeShape.Middle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">6dp</item>
    </style>
    <style name="EdgeShape.Bottom" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">6dp</item>
        <item name="cornerSizeTopRight">6dp</item>
        <item name="cornerSizeBottomLeft">28dp</item>
        <item name="cornerSizeBottomRight">28dp</item>
    </style>

    <!-- bottom sheets (how it works, swipe in): one step above page colour so they look different -->
    <style name="EdgeBottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/EdgeBottomSheet</item>
    </style>
    <style name="EdgeBottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">?attr/colorSurfaceContainerHigh</item>
    </style>

    <!-- all switches: tick / cross icon on thumb, it changes with animation -->
    <style name="EdgeSwitch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="thumbIcon">@drawable/sel_switch_thumb</item>
        <item name="thumbIconTint">@color/sw_thumb_icon_tint</item>
    </style>

    <!-- slide + fade between screens -->
    <style name="EdgeWindowAnim" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/edge_open_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/edge_open_exit</item>
        <item name="android:activityCloseEnterAnimation">@anim/edge_close_enter</item>
        <item name="android:activityCloseExitAnimation">@anim/edge_close_exit</item>
    </style>

    <!-- small coloured heading above group of cards -->
    <style name="EdgeSectionTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:layout_marginTop">24dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelLarge</item>
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>

    <!-- list item parts: icon, headline, supporting text -->
    <style name="EdgeListRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">64dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
    </style>

    <style name="EdgeListRow.Clickable">
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="EdgeIconBox">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_marginEnd">16dp</item>
        <item name="android:background">@drawable/bg_icon_box</item>
        <item name="android:padding">8dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:tint">?attr/colorOnSecondaryContainer</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

    <style name="EdgeHeadline">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">?attr/textAppearanceBodyLarge</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="EdgeSupporting">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">?attr/textAppearanceBodyMedium</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="EdgeDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">72dp</item>
        <item name="android:layout_marginEnd">16dp</item>
    </style>
</resources>
